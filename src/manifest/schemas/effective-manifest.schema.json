{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sh-core-ui.dev/schemas/effective-manifest-1.0.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "version", "issuedAt", "decisions"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "version": { "type": "string", "minLength": 1 },
    "manifestId": { "type": "string", "minLength": 1 },
    "issuer": { "type": "string", "minLength": 1 },
    "audience": { "type": "string", "minLength": 1 },
    "application": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "tenantId": { "type": "string", "minLength": 1 },
        "sessionId": { "type": "string", "minLength": 1 }
      }
    },
    "issuedAt": { "type": "string", "format": "date-time" },
    "notBefore": { "type": "string", "format": "date-time" },
    "expiresAt": { "type": "string", "format": "date-time" },
    "context": { "$ref": "#/$defs/context" },
    "defaults": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "deniedBehavior": { "enum": ["hide", "disable", "readOnly"] }
      }
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["resource", "action", "allowed"],
        "properties": {
          "resource": { "type": "string", "minLength": 1 },
          "action": { "type": "string", "minLength": 1 },
          "allowed": { "type": "boolean" },
          "when": { "$ref": "#/$defs/context" },
          "ui": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "deniedBehavior": { "enum": ["hide", "disable", "readOnly"] },
              "reasonCode": { "type": "string" },
              "messageKey": { "type": "string" }
            }
          }
        }
      }
    },
    "cache": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "refreshAfter": { "type": "string", "format": "date-time" },
        "staleAt": { "type": "string", "format": "date-time" },
        "etag": { "type": "string" }
      }
    }
  },
  "$defs": {
    "context": {
      "type": "object",
      "additionalProperties": {
        "type": ["string", "number", "boolean", "null"]
      }
    }
  }
}
