{
  "name": "sh-core-ui",
  "version": "0.1.0",
  "description": "Domain-agnostic policy-aware enterprise UI platform",
  "license": "MIT",
  "type": "module",
  "main": "./dist/cjs/index.cjs",
  "module": "./dist/esm/index.js",
  "types": "./dist/types/index.d.ts",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.cjs"
    },
    "./components": {
      "types": "./dist/types/components/index.d.ts",
      "import": "./dist/esm/components/index.js",
      "require": "./dist/cjs/components/index.cjs"
    },
    "./grid": {
      "types": "./dist/types/grid/index.d.ts",
      "import": "./dist/esm/grid/index.js",
      "require": "./dist/cjs/grid/index.cjs"
    },
    "./policy": {
      "types": "./dist/types/policy/index.d.ts",
      "import": "./dist/esm/policy/index.js",
      "require": "./dist/cjs/policy/index.cjs"
    },
    "./manifest": {
      "types": "./dist/types/manifest/index.d.ts",
      "import": "./dist/esm/manifest/index.js",
      "require": "./dist/cjs/manifest/index.cjs"
    },
    "./tokens": {
      "types": "./dist/types/tokens/index.d.ts",
      "import": "./dist/esm/tokens/index.js",
      "require": "./dist/cjs/tokens/index.cjs"
    },
    "./locales": {
      "types": "./dist/types/locales/index.d.ts",
      "import": "./dist/esm/locales/index.js",
      "require": "./dist/cjs/locales/index.cjs"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "clean": "rimraf dist storybook-static coverage fixtures/button-only/dist fixtures/form-subset/dist fixtures/grid/dist",
    "build": "npm run clean && webpack --config webpack.config.cjs && tsc -p tsconfig.build.json --emitDeclarationOnly && node scripts/copy-assets.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "format:check": "prettier --check .",
    "test": "jest --runInBand",
    "manifest:check": "node scripts/manifest-cli.mjs validate examples/manifests/definition-commerce.json examples/manifests/definition-content.json examples/manifests/effective.json && node scripts/manifest-cli.mjs lint examples/manifests/definition-commerce.json",
    "test:tree-shaking": "node scripts/test-tree-shaking.mjs",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run manifest:check && npm run build && npm run test:tree-shaking && npm run build-storybook",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "npm run check && changeset publish"
  },
  "peerDependencies": {
    "@ant-design/icons": ">=5 <7",
    "ag-grid-community": ">=33 <36",
    "ag-grid-enterprise": ">=33 <36",
    "ag-grid-react": ">=33 <36",
    "antd": ">=5 <7",
    "react": ">=18 <20",
    "react-dom": ">=18 <20"
  },
  "devDependencies": {
    "@ant-design/icons": "^6.0.0",
    "@changesets/cli": "^2.29.7",
    "@storybook/addon-a11y": "^8.6.14",
    "@storybook/addon-essentials": "^8.6.14",
    "@storybook/addon-interactions": "^8.6.14",
    "@storybook/react-webpack5": "^8.6.14",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.18.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@typescript-eslint/eslint-plugin": "^8.41.0",
    "@typescript-eslint/parser": "^8.41.0",
    "ag-grid-community": "^34.2.0",
    "ag-grid-enterprise": "^34.2.0",
    "ag-grid-react": "^34.2.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "antd": "^5.27.1",
    "css-loader": "^7.1.2",
    "eslint": "^9.34.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "fork-ts-checker-webpack-plugin": "^9.1.0",
    "jest": "^30.1.3",
    "jest-axe": "^10.0.0",
    "jest-environment-jsdom": "^30.1.2",
    "prettier": "^3.6.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "rimraf": "^6.0.1",
    "storybook": "^8.6.14",
    "style-loader": "^4.0.0",
    "ts-jest": "^29.4.1",
    "ts-loader": "^9.5.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.41.0",
    "webpack": "^5.101.3",
    "webpack-cli": "^6.0.1"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  }
}
